# Copy to .env (git-ignored) and fill in. Every variable below is optional unless noted.

# --- Server (backend/main.py) ---
# annotation = no models/indices preloaded, search = lazy Arabic encoder, research = eager Arabic encoder
APP_MODE=search
# Comma-separated origins, or * for all (disables credentials)
CORS_ORIGINS=http://localhost:5173
# Built frontend directory (defaults to ../static or ../frontend/dist)
# STATIC_DIR=

# --- Database (PostgreSQL with the pgvector extension) ---
# Required. The driver must be psycopg (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://hadith:change-me@localhost:5432/hadith
# docker compose only (required there): the password for the postgres service. Letters, digits,
# "-" and "_" only, because compose puts it into DATABASE_URL.
# POSTGRES_PASSWORD=
# Blue/green releases: images for each colour (tools/deploy.sh sets these; defaults below)
# BLUE_IMAGE=hadith-search:blue
# GREEN_IMAGE=hadith-search:green
# Tests only: a throwaway database the test suite may create schemas in (skips if unreachable)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:test-only-password@localhost:55432/hadith_test

# --- Feature toggles (backend/features.py) ---
# APP_MODE is a preset; any FEATURE_<NAME> below overrides it (true/false, 1/0, yes/no, on/off)
# FEATURE_ANNOTATION=true       # annotation + auth routers
# FEATURE_KV_PAIRS=true         # kv_pairs router
# FEATURE_BENCHMARK=true        # benchmark router
# FEATURE_SEARCH=true           # /search/* endpoints and index preload
# FEATURE_DENSE_RETRIEVAL=true  # Arabic semantic search (semantic-rerank, cosine, semantic-rrf)
# FEATURE_EAGER_MODEL=false     # load the Arabic encoder at startup instead of on first request

# --- Arabic semantic search ---
# Folder with model.onnx and tokenizer.json, made by `python -m scripts.export_onnx`
# ARABIC_MODEL_DIR=backend/data/onnx/arabic

# --- Data build ---
# Path to a local LK Hadith Corpus checkout (scripts/data_creation.py)
# LK_HADITH_CORPUS_PATH=
# Set to 1 to let pooling.py continue when some retrieval systems fail
ALLOW_PARTIAL_POOLING=0

# --- LLM used by llm_grader.py and kv_generator.py (OpenAI-compatible API) ---
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_WORKERS=5
LLM_MAX_RETRIES=3
# Timeout in seconds (default 30 in llm_grader.py, 60 in kv_generator.py)
# LLM_TIMEOUT=30
KV_PAIRS_PER_TOPIC=100
KV_BATCH_SIZE=20

# --- Fine-tuning (scripts/finetune.py) ---
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1
FINETUNE_BATCH_SIZE=16
FINETUNE_LR=2e-5
FINETUNE_EPOCHS=20
FINETUNE_PATIENCE=3
FINETUNE_VAL_SPLIT=0.15
FINETUNE_SEED=42
MNRL_TEMPERATURE=0.05

# --- Auth tokens (signed JWTs, checked without a database lookup) ---
# Every server behind one load balancer, and both blue and green colours, must use the same value. At least 32 characters.
# If unset, a random secret is made at startup and tokens stop working on restart.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=
# AUTH_TOKEN_TTL_MINUTES=720

# docker compose passes these to the app (defaults: annotation mode, no search)
# APP_MODE=search
# FEATURE_ANNOTATION=false
# FEATURE_BENCHMARK=false
# FEATURE_DENSE_RETRIEVAL=false
