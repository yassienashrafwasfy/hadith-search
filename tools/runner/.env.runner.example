# Copy to .env.runner (git-ignored) and fill in. Never commit the real file.
# https://github.com/<owner>/<repo>
REPO_URL=
# Fine-grained token for THIS repository only, permission "Administration: Read and write"
# (only used to register the runner each time it restarts). Not the same as RUNNER_STATUS_TOKEN.
ACCESS_TOKEN=
# RUNNER_NAME=hadith-wsl
