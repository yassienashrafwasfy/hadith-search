# Alertmanager: e-mails every alert (docs/HANDOFF.md item 47). The ${...} names are filled from .env by
# entrypoint.sh when the container starts; the SMTP password is read from a file, never written here.
global:
  smtp_smarthost: "${SMTP_HOST}"
  smtp_from: "${ALERT_EMAIL_FROM}"
  smtp_auth_username: "${SMTP_USERNAME}"
  smtp_auth_password_file: /tmp/alertmanager/smtp_password
  smtp_require_tls: true

route:
  receiver: email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h  # a warning that stays on is mailed again every 4 hours
  routes:
    - matchers: [severity="critical"]
      receiver: email
      repeat_interval: 1h

receivers:
  - name: email
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        send_resolved: true

# A critical search latency alert makes the warning for the same thing redundant.
inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [family]
